# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-resume-analyzer

# Redis (job queue + rate limiting + refresh-token blacklist)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# File storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/resumes
MAX_UPLOAD_SIZE_MB=5

# AWS S3 (used when STORAGE_PROVIDER=s3)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Quotas
DAILY_ANALYSIS_LIMIT=5

# Email — used for password-reset links and the Contact page.
# If left blank, the app still works fully; it just logs what would have
# been sent instead of actually sending it (see server/README.md).
#
# To send real email via Gmail:
#   1. Turn on 2-Step Verification on the Google account you want to send from
#   2. Google Account -> Security -> 2-Step Verification -> App Passwords
#   3. Generate a 16-character app password (NOT your normal Gmail password)
#      and paste it below as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sandeepnarlapuram0@gmail.com
SMTP_PASSWORD=
EMAIL_FROM="ScoreMyResume <sandeepnarlapuram0@gmail.com>"
# Where Contact-page submissions get sent. Defaults to SMTP_USER if unset.
CONTACT_RECIPIENT_EMAIL=sandeepnarlapuram0@gmail.com
